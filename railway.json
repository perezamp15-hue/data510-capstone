{
  "$schema": "https://railway.app/railway.schema.json",
  "build": {
    "builder": "RAILPACK"
  },
  "deploy": {
    "startCommand": "python main.py"
  },
  "services": {
    "data-scraper-service": {
      "source": ".",
      "deploy": {
        "startCommand": "python src/fetch_lineups.py",
        "cronSchedule": "*/30 13-20 * * *"
      }
    },
    "simulation-engine-service": {
      "source": ".",
      "deploy": {
        "startCommand": "python src/simulation_engine.py",
        "cronSchedule": "0 18 * * *"
      }
    }
  }
}
